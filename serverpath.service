[Unit]
Description=ServerPath website (Express + built React client)
After=network.target

[Service]
# PALITAN ng actual path sa Ubuntu server, hal: /home/student/Antoniano-ut-Project
WorkingDirectory=/home/student/Antoniano-ut-Project
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=5
Environment=PORT=4000
Environment=HOST=0.0.0.0
Environment=NODE_ENV=production
# Log: journalctl -u serverpath -f

[Install]
WantedBy=multi-user.target
