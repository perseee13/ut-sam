# ServerPath local config — MySQL (XAMPP default) + JWT.
PORT=4000
HOST=0.0.0.0

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=serverpath

# MQTT broker topic — must match what your ESP32 publishes to
MQTT_BROKER=mqtt://10.219.89.89:1883
MQTT_TOPIC=esp32/turbidity_tds_light_data

# Any long random string. Change this in production!
JWT_SECRET=serverpath-dev-secret-change-me
